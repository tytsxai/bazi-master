# bazi-master —— 算法能力层 API，生产配置模板
#
# 引擎是无状态的纯计算：不存数据、不认用户、没有数据库、没有迁移、没有备份。
# 因此这份模板里没有任何数据库、会话、OAuth、SMTP 相关的配置 —— 那些能力连同
# 存储层一起被删除了，留着它们只会让人以为配了就有用。
#
# 唯一的硬性必填项是 DOCS_PASSWORD：缺了它 server.js 在生产模式下启动即退出。
# 其余全部有默认值，但下面标注了「生产强烈建议」的几项应该配上。
#
# 复制成 .env.production 后使用：cp env.production.template .env.production

# ---------------------------------------------------------------- 进程
NODE_ENV=production
PORT=4000

# 优雅停机。SIGTERM 之后 /health 和 /api/ready 立即转 503，等 SHUTDOWN_DRAIN_MS
# 让负载均衡把本实例摘掉，再关闭监听。实测：readiness 在 +2ms 翻转，配 3000 时监听在
# +3007ms 关闭，进程在 +3018ms 退出。
#
# 5000 只够被动检查的 nginx。按「探测间隔 x 失败阈值」加余量选：
#   nginx (passive, proxy_next_upstream)  ~1x fail_timeout      -> 5000 够
#   k8s readinessProbe defaults           10s x 3   = 30s       -> 35000
#   AWS ALB target group defaults         30s x 2   = 60s       -> 65000
# 它必须小于编排层的 stop grace period，否则排水会被 SIGKILL 打断：
# docker-compose.prod.yml 里 stop_grace_period 是 30s，所以这里超过 ~15000 就要同步调大它
#（k8s 上对应 terminationGracePeriodSeconds）。
# 强制退出的总预算是 SHUTDOWN_DRAIN_MS + GRACEFUL_SHUTDOWN_TIMEOUT_MS。
SHUTDOWN_DRAIN_MS=5000
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=10000

# 可选的 HTTP server 超时（ms）
# SERVER_KEEP_ALIVE_TIMEOUT_MS=5000
# SERVER_HEADERS_TIMEOUT_MS=60000
# SERVER_REQUEST_TIMEOUT_MS=300000

# 宿主上发布端口绑定的网卡。默认回环，把 TLS 终结交给前面的反向代理；
# 只有在确认宿主防火墙就是边界时才改成 0.0.0.0。
BACKEND_BIND_ADDR=127.0.0.1
BACKEND_MEMORY_LIMIT=1g
# 容器*内部*的监听地址。这里填 0.0.0.0 是对的 —— 容器网络才是边界，
# 对外暴露与否由上面那个宿主绑定决定。
BIND_HOST=0.0.0.0

# ---------------------------------------------------------------- 网络与 CORS
# 引擎自己的对外地址，只用于 OpenAPI 文档里的 servers 字段。
BACKEND_BASE_URL=https://api.yourdomain.com

# 允许跨域的调用方来源，逗号分隔。
# 服务端到服务端、Agent 调用不带 Origin 头，不受这里影响；只有浏览器客户端要登记。
# 留空时浏览器客户端会被全部拒绝，启动时会打一条 warning（不是错误）。
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

# 反向代理跳数。一层 nginx 就填 1。
# 填 true 等于信任任意 X-Forwarded-For，限流会被伪造请求头绕过 —— 不要这么填。
TRUST_PROXY=1

# ---------------------------------------------------------------- 缓存（可选）
# Redis 在这里只做一件事：在多实例之间共享八字排盘缓存。
# 不配就每个实例各用自己的进程内缓存 —— 结果完全一致，只是命中率低一些。
# 它不再承载会话、限流计数或任何与正确性相关的状态。
REDIS_URL=redis://redis:6379
REDIS_CONNECT_TIMEOUT_MS=3000
BAZI_CACHE_TTL_MS=21600000
BAZI_CACHE_MAX_ENTRIES=500

# ---------------------------------------------------------------- 限流与输入上限
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# 请求体上限。调大它就等于调大单个请求能吃掉的内存。
# 反向代理的 body-size 上限应该跟这里一致，让超大请求在边缘就被拒，而不是先缓冲再拒。
JSON_BODY_LIMIT=1mb
MAX_URL_LENGTH=16384
# JSON 请求体的形状护栏
MAX_INPUT_ARRAY_LENGTH=1000
MAX_INPUT_DEPTH=10
MAX_INPUT_KEYS=200
MAX_INPUT_STRING_LENGTH=10000

# ---------------------------------------------------------------- AI（可选）
# 只影响 /ai-interpret 这类解读接口，完全不影响排盘。
# 不配任何密钥时 AI_PROVIDER 自动落到 mock。
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your_anthropic_key
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
AI_MAX_TOKENS=1000
AI_TIMEOUT_MS=20000

# ---------------------------------------------------------------- API 文档
# /api-docs 与 /api-docs.json 的 Basic Auth。
# DOCS_PASSWORD 是生产模式下唯一的硬性必填项：缺了它进程启动即退出。
DOCS_USER=admin
DOCS_PASSWORD=secure_docs_password_change_me

# ---------------------------------------------------------------- 日志
# trace | debug | info | warn | error | fatal。排查时临时调到 debug，生产默认 info。
LOG_LEVEL=info

# ---------------------------------------------------------------- 可观测性
SENTRY_DSN=
# 在 Sentry 界面里区分 staging 与 production。默认取 NODE_ENV。
SENTRY_ENVIRONMENT=production
# 发布标识（commit sha 或 tag）。没有它就没法把一个错误关联到引入它的那次发布，
# 而回滚决策正是建立在这上面的。
SENTRY_RELEASE=
# 采样比例。1.0 会在几天内把小额度耗光，之后真正的错误开始被丢弃。
SENTRY_TRACES_SAMPLE_RATE=0.1
# Profiling 在额度和 CPU 上都贵，除非在排查否则保持 0。
SENTRY_PROFILES_SAMPLE_RATE=0

# /metrics（Prometheus 文本格式）
# 抓取方必须带的 Bearer token。留空时该端点在生产环境返回 404 —— 这是安全默认值，
# 不是遗漏：它会暴露连接数和内存占用，不该无鉴权对外提供。生成方式：
#   openssl rand -hex 32
# 直接从后端抓（127.0.0.1:4000/metrics），不要经公网反向代理暴露。
METRICS_TOKEN=
# 深度健康检查结果的复用时长（ms）。/health 注册在限流之前，探针永远不会被限流，
# 这也意味着一个无鉴权的请求循环本来会变成无上限的检查负载。探针每 5-10s 跑一次，
# 1s 的缓存对它们没有任何代价。0 表示关闭缓存（每个请求都重新检查）。
HEALTH_CACHE_TTL_MS=1000

# ---------------------------------------------------------------- 安全开关
# 允许生产模式下 BACKEND_BASE_URL 指向 localhost（只在本地模拟生产时用）。
ALLOW_LOCALHOST_PROD=false

# ---------------------------------------------------------------- Redis 容器资源
# 只在用 docker-compose.prod.yml 自带的 redis 时有意义。
REDIS_MAXMEMORY=256mb
# 必须大于 REDIS_MAXMEMORY：AOF 重写期间 Redis 会 fork，短时内存占用会高出一截。
REDIS_MEMORY_LIMIT=512m

# ---------------------------------------------------------------- Autoheal
# 重启健康检查报 unhealthy 的容器。
AUTOHEAL_INTERVAL=10
# 观察者启动后的宽限期，避免刚起的栈被反复重启。
AUTOHEAL_START_PERIOD=60
# 优雅停止预算。要 >= 后端的 stop_grace_period（30s），否则重启会打断正在处理的请求。
AUTOHEAL_DOCKER_TIMEOUT=40
