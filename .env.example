# bazi-master —— 算法能力层 API
#
# 引擎是无状态的纯计算：不存数据、不认用户、没有数据库。
# 下面每一项都可以留空跑起来；生产环境的必填项只有 DOCS_PASSWORD。

# Backend (Express)
NODE_ENV=development
PORT=4000
BACKEND_BASE_URL=http://localhost:4000
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
# 排空期：readiness 先转 503，等负载均衡摘掉本实例，再关闭监听。
SHUTDOWN_DRAIN_MS=

# 允许跨域的调用方来源，逗号分隔。服务端到服务端、Agent 调用不带 Origin 头，不受这里影响；
# 只有浏览器客户端需要在这里登记。
CORS_ALLOWED_ORIGINS=http://localhost:3000
# 反向代理跳数。填 1 表示"信任一跳"；填 true 等于信任任意 X-Forwarded-For，
# 限流会被伪造头绕过，不要这么填。
TRUST_PROXY=

# 请求体与 URL 上限
JSON_BODY_LIMIT=1mb
MAX_URL_LENGTH=16384

# Redis（可选，纯缓存）
# 只用来在多实例之间共享八字排盘缓存。不配就每个实例各用自己的进程内缓存——
# 结果完全一致，只是命中率低一些。它不再承载会话或任何正确性相关的状态。
REDIS_URL=
BAZI_CACHE_TTL_MS=21600000
BAZI_CACHE_MAX_ENTRIES=500

# 限流（生产默认开启；开发环境填 0 关闭）
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# AI Providers（可选，只影响 /ai-interpret 这类解读接口，不影响排盘）
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
AI_MAX_TOKENS=700
AI_TIMEOUT_MS=15000

# API 文档访问（/api-docs、/api-docs.json）
# 生产环境必填 DOCS_PASSWORD，否则进程启动时直接报错退出。
DOCS_USER=admin
DOCS_PASSWORD=

# 可观测性
# 不配 METRICS_TOKEN 时，/metrics 在生产环境返回 404（视为未暴露）。
METRICS_TOKEN=
HEALTH_CACHE_TTL_MS=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0

# 安全开关
# 允许生产环境的 BACKEND_BASE_URL 指向 localhost（只在本地模拟生产时用）。
ALLOW_LOCALHOST_PROD=false
